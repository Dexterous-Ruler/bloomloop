# --- copy this file to server/.env and fill in ---

# Question generation (F2). If absent, the server falls back to a deterministic
# offline generator and every item is stamped source:"fallback" in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Persistence -------------------------------------------------------------
# Primary store: Supabase. Run every file in supabase/migrations/, in number order, first
# (see supabase/README.md).
#   URL  : Supabase dashboard -> Project Settings -> Data API -> Project URL
#   KEY  : Project Settings -> API Keys -> service_role  (SECRET - server only,
#          it bypasses row level security; never ship it to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional second choice, tried only if Supabase is unset or unreachable.
MONGO_URI=

# With neither set the server runs on an in-process store: everything works,
# nothing survives a restart, and it says so loudly at boot.

PORT=5050

# Gates every teacher-only route (content, generation, bank, sessions, grid,
# export). Students never need it - they have the room code and a roll number.
# Leave blank and one is generated at each boot and printed in the boot banner;
# set it to keep the same key across restarts.
TEACHER_KEY=

# F6 Tier 2 - Google Classroom. Leave blank to demo Tier 1 (CSV) only.
# Redirect URI to register: http://localhost:5050/api/classroom/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the Learning Hub's serve tokens and the interaction tokens of tap/label
# questions. Set it once per deployment and keep it: changing it voids the tokens
# out at that moment. Without it the server derives one from its service-role key.
SERVER_SECRET=

# Laptop mode only (npm --workspace server run laptop): where each room is saved
# while it runs, and how often (seconds).
LAPTOP_ARCHIVE_DIR=
LAPTOP_ARCHIVE_SECONDS=

# Extra origins allowed to call the API (comma-separated), for a client served elsewhere.
CORS_ORIGINS=

# Exam mode's Safe Exam Browser check compares the page address SEB reports with
# this server's own. Behind a proxy that ends TLS (Koyeb, for one), set the public
# address here, or set TRUST_PROXY=1 so X-Forwarded-* headers are believed.
PUBLIC_ORIGIN=
TRUST_PROXY=
